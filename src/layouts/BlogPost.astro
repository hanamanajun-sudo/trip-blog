---
import BaseLayout from './BaseLayout.astro';
import { slugify } from '../utils/slugify';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CoupangBanner from '../components/CoupangBanner.astro';

interface AdjacentPost {
  title: string;
  url: string;
}

export interface Props {
  title: string;
  date: Date;
  category: string;
  description?: string;
  thumbnail?: string;
  ogImage?: string;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  canonicalUrl?: string;
  prevPost?: AdjacentPost | null;
  nextPost?: AdjacentPost | null;
}

const { title, date, category, description, thumbnail, ogImage, currentId, headings = [], canonicalUrl, prevPost, nextPost } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const siteUrl = 'https://trip.lalalakorea.com';
const pageUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const categorySlug = slugify(category);

// OG/구조화데이터용 이미지: thumbnail > 본문 첫 이미지(ogImage) > 기본 이미지
const articleImage = thumbnail || ogImage || `${siteUrl}/og-default.png`;
const absoluteArticleImage = articleImage.startsWith('http') ? articleImage : `${siteUrl}${articleImage}`;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "image": [absoluteArticleImage],
  "author": {
    "@type": "Person",
    "name": "trip.lalalakorea",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "trip.lalalakorea",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/og-default.png`
    }
  },
  "description": description || title,
  "url": pageUrl,
  "articleSection": category,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": category, "item": `${siteUrl}/category/${categorySlug}` },
    { "@type": "ListItem", "position": 3, "name": title, "item": pageUrl }
  ]
};
---

<BaseLayout
  title={`${title} | trip.lalalakorea`}
  description={description}
  ogImage={thumbnail || ogImage}
  jsonLd={[blogPostingSchema, breadcrumbSchema]}
  ogType="article"
  ogDatePublished={date.toISOString()}
  canonicalUrl={canonicalUrl}
>
  <article class="mx-auto max-w-3xl">

    <!-- 브레드크럼 -->
    <nav aria-label="현재 위치" class="mb-5">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
        <li><a href="/" class="hover:text-primary transition-colors">홈</a></li>
        <li aria-hidden="true" class="opacity-50">/</li>
        <li><a href={`/category/${categorySlug}`} class="hover:text-primary transition-colors">{category}</a></li>
        <li aria-hidden="true" class="opacity-50">/</li>
        <li class="text-foreground/70 line-clamp-1 max-w-[60%]">{title}</li>
      </ol>
    </nav>

    <!-- 헤더 영역 -->
    <div class="mb-8 space-y-4">
      <!-- 카테고리 뱃지 -->
      <a
        href={`/category/${categorySlug}`}
        class="inline-flex items-center rounded-md border border-border bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent"
      >
        {category}
      </a>

      <!-- 제목 -->
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-foreground lg:text-4xl">
        {title}
      </h1>

      <!-- 날짜 -->
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>

      <!-- 구분선 -->
      <hr class="border-border" />
    </div>

    <!-- 목차 (TOC) -->
    <TableOfContents headings={headings} />

    <!-- 본문 -->
    <div class="prose prose-neutral max-w-none
      prose-headings:font-semibold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:leading-7 prose-p:text-foreground
      prose-a:text-primary prose-a:underline-offset-4 hover:prose-a:text-primary/80
      prose-blockquote:border-l-4 prose-blockquote:border-border prose-blockquote:bg-muted prose-blockquote:rounded-r-lg prose-blockquote:py-2 prose-blockquote:px-4
      prose-img:rounded-lg prose-img:shadow-sm
      prose-strong:text-foreground
      prose-code:rounded prose-code:bg-muted prose-code:px-1 prose-code:py-0.5 prose-code:text-sm
    ">
      <slot />
    </div>

    <!-- 쿠팡 배너 (본문 아래) -->
    <CoupangBanner />

    <!-- 소셜 공유 버튼 -->
    <ShareButtons title={title} url={pageUrl} />

    <!-- 관련 글 추천 -->
    {currentId && <RelatedPosts category={category} currentId={currentId} />}

    <!-- 이전/다음 글 네비게이션 -->
    {(prevPost || nextPost) && (
      <nav aria-label="이전/다음 글" class="mt-8 grid grid-cols-2 gap-3">
        {prevPost ? (
          <a href={prevPost.url} class="group flex flex-col gap-1 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:shadow-md transition-all col-start-1">
            <span class="text-xs text-muted-foreground flex items-center gap-1">
              <i class="ph ph-arrow-left text-xs" aria-hidden="true"></i> 이전 글
            </span>
            <span class="text-sm font-semibold line-clamp-2 group-hover:text-primary transition-colors">{prevPost.title}</span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={nextPost.url} class="group flex flex-col gap-1 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:shadow-md transition-all text-right col-start-2">
            <span class="text-xs text-muted-foreground flex items-center justify-end gap-1">
              다음 글 <i class="ph ph-arrow-right text-xs" aria-hidden="true"></i>
            </span>
            <span class="text-sm font-semibold line-clamp-2 group-hover:text-primary transition-colors">{nextPost.title}</span>
          </a>
        ) : <div />}
      </nav>
    )}

    <!-- 목록으로 -->
    <div class="mt-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <i class="ph ph-arrow-left text-xs" aria-hidden="true"></i> 목록으로 돌아가기
      </a>
    </div>

    <!-- 작성자 박스 -->
    <div class="mt-10 rounded-2xl border border-border bg-muted/40 p-5">
      <p class="text-xs text-muted-foreground mb-3 font-medium">이 글을 쓴 사람들</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex items-center gap-3 flex-1">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center text-white text-lg font-bold select-none">
            L
          </div>
          <div>
            <p class="font-semibold text-foreground text-sm">랄라</p>
            <p class="text-xs text-muted-foreground mt-0.5">호기심 여행자. "이 나라 우리나라 몇 배야?" 질문 던지는 역할. 솔직한 감상 담당.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 flex-1">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-white text-lg font-bold select-none">
            K
          </div>
          <div>
            <p class="font-semibold text-foreground text-sm">케이</p>
            <p class="text-xs text-muted-foreground mt-0.5">팩트 담당. 면적·인구·시차·물가 수치를 정리하고 비교표 만드는 역할.</p>
          </div>
        </div>
      </div>
      <p class="text-xs text-muted-foreground/60 mt-3 pt-3 border-t border-border">
        두 캐릭터가 함께 만드는 블로그 · <a href="/about" class="hover:text-primary transition-colors underline underline-offset-2">블로그 소개 →</a>
      </p>
    </div>

  </article>
</BaseLayout>
