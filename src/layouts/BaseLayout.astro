---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object;
  ogType?: string;
  ogDatePublished?: string;
}

const {
  title,
  description = '세계 여행, 나라 정보, 역사 이야기를 담은 블로그',
  ogImage,
  jsonLd,
  ogType = 'website',
  ogDatePublished,
} = Astro.props;
const siteOgImage = ogImage || 'https://trip.lalalakorea.com/og-default.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- 파비콘 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- OG Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={siteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="lalalakorea" />
  <meta property="og:locale" content="ko_KR" />
  {ogDatePublished && <meta property="article:published_time" content={ogDatePublished} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={siteOgImage} />

  <!-- 네이버 서치어드바이저 -->
  <meta name="naver-site-verification" content="98ea4d780cc8adbe7f97539adee9117e4e3dd4a6" />

  <!-- JSON-LD 구조화 데이터 -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- 폰트: Pretendard (한글 최적화) -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css" />

  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
</head>
<body class="min-h-screen bg-background font-sans antialiased text-foreground">

  <!-- 헤더 -->
  <header class="sticky top-0 z-50 w-full border-b border-border bg-white/90 backdrop-blur-md shadow-sm">
    <div class="container mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
      <!-- 로고 -->
      <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight text-primary hover:opacity-80 transition-opacity">
        <i class="ph ph-airplane-takeoff text-2xl text-accent"></i>
        <span>lalalakorea</span>
      </a>
      <!-- 네비게이션 -->
      <nav class="flex items-center gap-1 text-sm font-medium">
        <a href="/" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-house text-base"></i>
          <span class="hidden sm:inline">홈</span>
        </a>
        <a href="/category/해외-여행" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-globe text-base"></i>
          <span class="hidden sm:inline">해외여행</span>
        </a>
        <a href="/category/국내-여행" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-map-pin text-base"></i>
          <span class="hidden sm:inline">국내여행</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- 메인 -->
  <main class="container mx-auto max-w-5xl px-4 py-10">
    <slot />
  </main>

  <!-- 푸터 -->
  <footer class="border-t border-border mt-20 bg-white">
    <div class="container mx-auto max-w-5xl px-4 py-10">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-bold text-primary">
          <i class="ph ph-airplane-takeoff text-xl text-accent"></i>
          <span>lalalakorea</span>
        </div>
        <p class="text-sm text-muted-foreground text-center">
          세계 여행, 나라 정보, 역사 이야기
        </p>
        <p class="text-xs text-muted-foreground">
          © {new Date().getFullYear()} lalalakorea
        </p>
      </div>
    </div>
  </footer>

</body>
</html>
