---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object;
  ogType?: string;
  ogDatePublished?: string;
}

const {
  title,
  description = '세계 여행, 나라 정보, 역사 이야기를 담은 블로그',
  ogImage,
  jsonLd,
  ogType = 'website',
  ogDatePublished,
} = Astro.props;
const siteOgImage = ogImage || 'https://trip.lalalakorea.com/og-default.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- 파비콘 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- OG Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={siteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="lalalakorea" />
  <meta property="og:locale" content="ko_KR" />
  {ogDatePublished && <meta property="article:published_time" content={ogDatePublished} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={siteOgImage} />

  <!-- 네이버 서치어드바이저 -->
  <meta name="naver-site-verification" content="98ea4d780cc8adbe7f97539adee9117e4e3dd4a6" />

  <!-- JSON-LD 구조화 데이터 -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- 폰트: Pretendard (한글 최적화) -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css" />

  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>

  <!-- Pagefind 검색 (빌드 후 생성됨) -->
  <link rel="prefetch" href="/_pagefind/pagefind.js" as="script" />
</head>
<body class="min-h-screen bg-background font-sans antialiased text-foreground">

  <!-- 헤더 -->
  <header class="sticky top-0 z-50 w-full border-b border-border bg-white/90 backdrop-blur-md shadow-sm">
    <div class="container mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
      <!-- 로고 -->
      <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight text-primary hover:opacity-80 transition-opacity">
        <i class="ph ph-airplane-takeoff text-2xl text-accent"></i>
        <span>lalalakorea</span>
      </a>
      <!-- 네비게이션 -->
      <nav class="flex items-center gap-1 text-sm font-medium">
        <a href="/" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-house text-base"></i>
          <span class="hidden sm:inline">홈</span>
        </a>
        <a href="/category/해외-여행" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-globe text-base"></i>
          <span class="hidden sm:inline">해외여행</span>
        </a>
        <a href="/category/국내-여행" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-map-pin text-base"></i>
          <span class="hidden sm:inline">국내여행</span>
        </a>

        <!-- 검색 버튼 -->
        <button
          id="search-toggle"
          aria-label="검색"
          class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all"
        >
          <i class="ph ph-magnifying-glass text-base"></i>
          <span class="hidden sm:inline">검색</span>
        </button>
      </nav>

      <!-- 검색 오버레이 -->
      <div id="search-overlay" class="fixed inset-0 z-[100] hidden">
        <!-- 배경 딤 -->
        <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
        <!-- 검색 모달 -->
        <div class="relative z-10 flex flex-col items-center pt-20 px-4">
          <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl overflow-hidden border border-border">
            <!-- 검색창 헤더 -->
            <div class="flex items-center gap-3 px-4 py-3 border-b border-border">
              <i class="ph ph-magnifying-glass text-xl text-muted-foreground flex-shrink-0"></i>
              <input
                id="search-input"
                type="text"
                placeholder="여행지, 나라 이름, 키워드를 검색하세요..."
                class="flex-1 text-base outline-none bg-transparent text-foreground placeholder:text-muted-foreground"
                autocomplete="off"
              />
              <button id="search-close" aria-label="닫기" class="text-muted-foreground hover:text-foreground transition-colors">
                <i class="ph ph-x text-xl"></i>
              </button>
            </div>
            <!-- 검색 결과 -->
            <div id="search-results" class="max-h-[60vh] overflow-y-auto p-3">
              <div id="search-placeholder" class="py-10 text-center text-muted-foreground text-sm">
                <i class="ph ph-compass text-4xl mb-3 block text-accent/50"></i>
                검색어를 입력하면 109개 글에서 바로 찾아드려요
              </div>
            </div>
          </div>
          <p class="mt-3 text-white/50 text-xs">ESC 또는 배경 클릭으로 닫기</p>
        </div>
      </div>
    </div>
  </header>

  <!-- 메인 -->
  <main class="container mx-auto max-w-5xl px-4 py-10">
    <slot />
  </main>

  <!-- 푸터 -->
  <footer class="border-t border-border mt-20 bg-white">
    <div class="container mx-auto max-w-5xl px-4 py-10">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-bold text-primary">
          <i class="ph ph-airplane-takeoff text-xl text-accent"></i>
          <span>lalalakorea</span>
        </div>
        <p class="text-sm text-muted-foreground text-center">
          세계 여행, 나라 정보, 역사 이야기
        </p>
        <p class="text-xs text-muted-foreground">
          © {new Date().getFullYear()} lalalakorea
        </p>
      </div>
    </div>
  </footer>

  <!-- 검색 기능 스크립트 -->
  <script>
    // Pagefind 모듈 타입 선언
    let pagefind: any = null;

    // Pagefind 지연 로딩
    async function loadPagefind() {
      if (!pagefind) {
        try {
          pagefind = await import('/_pagefind/pagefind.js');
          await pagefind.init();
        } catch (e) {
          console.warn('Pagefind 로딩 실패 (로컬 개발 환경에서는 정상):', e);
        }
      }
      return pagefind;
    }

    // 검색 실행
    async function runSearch(query: string) {
      const resultsContainer = document.getElementById('search-results');
      const placeholder = document.getElementById('search-placeholder');
      if (!resultsContainer) return;

      if (!query.trim()) {
        resultsContainer.innerHTML = `
          <div id="search-placeholder" class="py-10 text-center text-muted-foreground text-sm">
            <i class="ph ph-compass text-4xl mb-3 block text-accent/50"></i>
            검색어를 입력하면 109개 글에서 바로 찾아드려요
          </div>`;
        return;
      }

      const pf = await loadPagefind();
      if (!pf) {
        resultsContainer.innerHTML = `<div class="py-8 text-center text-sm text-muted-foreground">검색을 사용하려면 먼저 배포가 필요합니다</div>`;
        return;
      }

      const search = await pf.search(query);
      const results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="py-10 text-center text-sm text-muted-foreground">
            <i class="ph ph-smiley-sad text-3xl mb-2 block"></i>
            "<strong>${query}</strong>" 검색 결과가 없습니다
          </div>`;
        return;
      }

      resultsContainer.innerHTML = results.map((r: any) => {
        const excerpt = r.excerpt?.replace(/<mark>/g, '<mark class="bg-blue-100 text-blue-800 rounded px-0.5">') || '';
        return `
          <a href="${r.url}" class="flex flex-col gap-1 p-3 rounded-xl hover:bg-primary/5 transition-colors group border border-transparent hover:border-primary/20 mb-1">
            <div class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors line-clamp-1">${r.meta?.title || '제목 없음'}</div>
            <div class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">${excerpt}</div>
          </a>`;
      }).join('');

      if (search.results.length > 8) {
        resultsContainer.innerHTML += `
          <a href="/search?q=${encodeURIComponent(query)}" class="flex items-center justify-center gap-1 mt-2 py-2 text-xs text-primary hover:underline">
            전체 결과 보기 (${search.results.length}개) <i class="ph ph-arrow-right"></i>
          </a>`;
      }
    }

    // UI 제어
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('search-toggle');
      const overlay = document.getElementById('search-overlay');
      const backdrop = document.getElementById('search-backdrop');
      const closeBtn = document.getElementById('search-close');
      const input = document.getElementById('search-input') as HTMLInputElement;

      function openSearch() {
        overlay?.classList.remove('hidden');
        setTimeout(() => input?.focus(), 50);
        loadPagefind(); // 미리 로딩
      }

      function closeSearch() {
        overlay?.classList.add('hidden');
        if (input) input.value = '';
        const results = document.getElementById('search-results');
        if (results) results.innerHTML = `
          <div id="search-placeholder" class="py-10 text-center text-muted-foreground text-sm">
            <i class="ph ph-compass text-4xl mb-3 block text-accent/50"></i>
            검색어를 입력하면 109개 글에서 바로 찾아드려요
          </div>`;
      }

      toggle?.addEventListener('click', openSearch);
      backdrop?.addEventListener('click', closeSearch);
      closeBtn?.addEventListener('click', closeSearch);

      // 키보드 단축키: / 키로 검색 열기, ESC로 닫기
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSearch();
        if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
          e.preventDefault();
          openSearch();
        }
      });

      // 검색어 입력 시 디바운스
      let debounceTimer: any;
      input?.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          runSearch((e.target as HTMLInputElement).value);
        }, 250);
      });

      // 엔터 키: 검색 페이지로 이동
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && input.value.trim()) {
          window.location.href = `/search?q=${encodeURIComponent(input.value.trim())}`;
        }
      });
    });
  </script>

</body>
</html>
