---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  ogType?: string;
  ogDatePublished?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = '세계 여행, 나라 정보, 역사 이야기를 담은 블로그',
  ogImage,
  jsonLd,
  ogType = 'website',
  ogDatePublished,
  canonicalUrl,
  noindex = false,
} = Astro.props;

const SITE = 'https://trip.lalalakorea.com';
// 상대경로(/images/...) 이미지는 절대 URL로 변환, 없으면 기본 OG 이미지
function toAbsolute(img?: string): string {
  if (!img) return `${SITE}/og-default.png`;
  if (img.startsWith('http')) return img;
  return `${SITE}${img.startsWith('/') ? '' : '/'}${img}`;
}
const siteOgImage = toAbsolute(ogImage);
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);
// jsonLd를 배열로 정규화 (여러 스키마 동시 출력 지원)
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// 네비/푸터용 카테고리 목록 (글 수 많은 순)
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slugify';
const _posts = await getCollection('blog', ({ data }: any) => !data.draft);
const _catCount = new Map<string, number>();
for (const p of _posts) {
  _catCount.set(p.data.category, (_catCount.get(p.data.category) || 0) + 1);
}
const navCategories = [..._catCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count, slug: slugify(name) }));
const totalPostCount = _posts.length;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="theme-color" content="#0EA5E9" />

  <!-- 파비콘 -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- OG Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={siteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="trip.lalalakorea" />
  <meta property="og:locale" content="ko_KR" />
  {ogDatePublished && <meta property="article:published_time" content={ogDatePublished} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={siteOgImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- 네이버 서치어드바이저 -->
  <meta name="naver-site-verification" content="98ea4d780cc8adbe7f97539adee9117e4e3dd4a6" />
  <!-- 구글 서치 콘솔: 아래 content에 인증 코드를 넣으세요 (Search Console > 설정 > 소유권 확인 > HTML 태그) -->
  <!-- <meta name="google-site-verification" content="여기에-인증코드" /> -->

  <!-- RSS 피드 -->
  <link rel="alternate" type="application/rss+xml" title="trip.lalalakorea" href="/rss.xml" />

  <!-- JSON-LD 구조화 데이터 -->
  {jsonLdList.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VE98EN4HB0" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-VE98EN4HB0');
  </script>

  <!-- 폰트: Pretendard (한글 최적화) -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css" />

  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>

</head>
<body class="min-h-screen bg-background font-sans antialiased text-foreground">

  <!-- 본문 바로가기 (접근성) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:top-3 focus:left-3 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white focus:shadow-lg">
    본문 바로가기
  </a>

  <!-- 헤더 -->
  <header class="sticky top-0 z-50 w-full border-b border-border bg-white/90 backdrop-blur-md shadow-sm">
    <div class="container mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
      <!-- 로고 -->
      <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight text-primary hover:opacity-80 transition-opacity">
        <i class="ph ph-airplane-takeoff text-2xl text-accent" aria-hidden="true"></i>
        <span>trip.lalalakorea</span>
      </a>
      <!-- 네비게이션 -->
      <nav class="flex items-center gap-1 text-sm font-medium" aria-label="주요 메뉴">
        <a href="/" aria-label="홈" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-house text-base" aria-hidden="true"></i>
          <span class="hidden sm:inline">홈</span>
        </a>

        <!-- 카테고리 드롭다운 -->
        <div class="relative group">
          <button aria-label="카테고리" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
            <i class="ph ph-squares-four text-base" aria-hidden="true"></i>
            <span class="hidden sm:inline">카테고리</span>
            <i class="ph ph-caret-down text-xs hidden sm:inline" aria-hidden="true"></i>
          </button>
          <div class="absolute right-0 top-full pt-2 w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all z-50">
            <ul class="rounded-xl border border-border bg-white shadow-xl py-2 max-h-[70vh] overflow-y-auto">
              {navCategories.map((cat) => (
                <li>
                  <a href={`/category/${cat.slug}`} class="flex items-center justify-between px-4 py-2 text-sm text-foreground/80 hover:bg-primary/10 hover:text-primary transition-colors">
                    <span>{cat.name}</span>
                    <span class="text-xs text-muted-foreground">{cat.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- 검색 버튼 -->
        <button id="search-toggle" aria-label="검색" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-foreground/70 hover:text-primary hover:bg-primary/10 transition-all">
          <i class="ph ph-magnifying-glass text-base" aria-hidden="true"></i>
          <span class="hidden sm:inline">검색</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- 검색 오버레이 -->
  <div id="search-overlay" class="fixed inset-0 z-[100] hidden">
    <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 flex flex-col items-center pt-20 px-4">
      <div class="w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-border overflow-hidden">
        <!-- 입력창 -->
        <div class="flex items-center gap-3 px-4 py-3 border-b border-border">
          <i class="ph ph-magnifying-glass text-xl text-muted-foreground flex-shrink-0" aria-hidden="true"></i>
          <input id="search-input" type="text" placeholder="여행지, 나라 이름으로 검색..." autocomplete="off"
            class="flex-1 text-base outline-none bg-transparent text-foreground placeholder:text-muted-foreground" />
          <button id="search-close" aria-label="닫기" class="text-muted-foreground hover:text-foreground transition-colors p-1">
            <i class="ph ph-x text-xl" aria-hidden="true"></i>
          </button>
        </div>
        <!-- 결과 -->
        <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2">
          <div id="search-hint" class="py-10 text-center text-muted-foreground text-sm">
            <i class="ph ph-compass text-4xl mb-3 block text-accent/40" aria-hidden="true"></i>
            {totalPostCount}개 글에서 바로 찾아드려요
          </div>
        </div>
      </div>
      <p class="mt-3 text-white/50 text-xs">ESC 또는 배경 클릭으로 닫기 &nbsp;·&nbsp; 엔터로 전체 검색</p>
    </div>
  </div>

  <!-- 메인 -->
  <main id="main-content" class="container mx-auto max-w-5xl px-4 py-10">
    <slot />
  </main>

  <!-- 푸터 -->
  <footer class="border-t border-border mt-20 bg-white">
    <div class="container mx-auto max-w-5xl px-4 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        <!-- 브랜드 -->
        <div class="md:col-span-1">
          <div class="flex items-center gap-2 font-bold text-primary mb-3">
            <i class="ph ph-airplane-takeoff text-xl text-accent" aria-hidden="true"></i>
            <span>trip.lalalakorea</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            우리나라와 비교해서<br />알아보는 세계 이야기
          </p>
        </div>

        <!-- 카테고리 -->
        <nav class="md:col-span-2" aria-label="카테고리">
          <h2 class="text-sm font-bold text-foreground mb-3">카테고리</h2>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
            {navCategories.map((cat) => (
              <li>
                <a href={`/category/${cat.slug}`} class="text-sm text-muted-foreground hover:text-primary transition-colors">
                  {cat.name} <span class="text-xs opacity-60">({cat.count})</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- 바로가기 -->
        <nav class="md:col-span-1" aria-label="사이트 링크">
          <h2 class="text-sm font-bold text-foreground mb-3">바로가기</h2>
          <ul class="space-y-2">
            <li><a href="/" class="text-sm text-muted-foreground hover:text-primary transition-colors">전체 글</a></li>
            <li><a href="/search" class="text-sm text-muted-foreground hover:text-primary transition-colors">검색</a></li>
            <li><a href="/rss.xml" class="text-sm text-muted-foreground hover:text-primary transition-colors">RSS 구독</a></li>
            <li><a href="/sitemap-index.xml" class="text-sm text-muted-foreground hover:text-primary transition-colors">사이트맵</a></li>
          </ul>
        </nav>
      </div>

      <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="text-xs text-muted-foreground">© {new Date().getFullYear()} trip.lalalakorea · 세계 여행 · 나라 정보 · 역사 이야기</p>
        <p class="text-xs text-muted-foreground">총 {totalPostCount}개의 글</p>
      </div>
    </div>
  </footer>

  <!-- Fuse.js 검색 (CDN, 빌드 과정에 영향 없음) -->
  <script is:inline define:vars={{ totalPostCount }}>window.__POST_COUNT__ = totalPostCount;</script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/7.0.0/fuse.min.js" is:inline></script>
  <script is:inline>
    var _fuse = null;

    function initSearch() {
      if (_fuse) return Promise.resolve(_fuse);
      return fetch('/search-index.json')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          _fuse = new Fuse(data, {
            keys: [{ name: 'title', weight: 0.6 }, { name: 'description', weight: 0.3 }, { name: 'category', weight: 0.1 }],
            threshold: 0.4, includeScore: true, minMatchCharLength: 2,
          });
          return _fuse;
        });
    }

    function renderResults(query) {
      var box = document.getElementById('search-results');
      var hint = document.getElementById('search-hint');
      if (!box) return;
      if (!query.trim()) {
        box.innerHTML = '<div id="search-hint" class="py-10 text-center text-muted-foreground text-sm"><i class="ph ph-compass text-4xl mb-3 block text-accent/40" aria-hidden="true"></i>' + (window.__POST_COUNT__ || '') + '개 글에서 바로 찾아드려요</div>';
        return;
      }
      initSearch().then(function(f) {
        var found = f.search(query).slice(0, 7);
        if (!found.length) {
          box.innerHTML = '<div class="py-8 text-center text-sm text-muted-foreground"><i class="ph ph-smiley-sad text-3xl mb-2 block" aria-hidden="true"></i>"' + query + '" 결과가 없어요</div>';
          return;
        }
        box.innerHTML = found.map(function(r) {
          var it = r.item;
          return '<a href="' + it.url + '" class="flex flex-col gap-1 px-3 py-2.5 rounded-xl hover:bg-primary/5 border border-transparent hover:border-primary/20 transition-all mb-1 group">' +
            '<span class="font-semibold text-sm text-foreground group-hover:text-primary line-clamp-1">' + it.title + '</span>' +
            (it.description ? '<span class="text-xs text-muted-foreground line-clamp-1">' + it.description + '</span>' : '') +
            '</a>';
        }).join('') +
        (found.length >= 7 ? '<a href="/search?q=' + encodeURIComponent(query) + '" class="flex items-center justify-center gap-1 py-2 mt-1 text-xs text-primary hover:underline">전체 결과 보기 <i class="ph ph-arrow-right" aria-hidden="true"></i></a>' : '');
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var toggle = document.getElementById('search-toggle');
      var overlay = document.getElementById('search-overlay');
      var backdrop = document.getElementById('search-backdrop');
      var closeBtn = document.getElementById('search-close');
      var input = document.getElementById('search-input');

      function open() {
        overlay.classList.remove('hidden');
        setTimeout(function() { input && input.focus(); }, 50);
        initSearch(); // 미리 로드
      }
      function close() {
        overlay.classList.add('hidden');
        if (input) { input.value = ''; }
        renderResults('');
      }

      toggle && toggle.addEventListener('click', open);
      backdrop && backdrop.addEventListener('click', close);
      closeBtn && closeBtn.addEventListener('click', close);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') close();
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
          e.preventDefault(); open();
        }
      });

      var _t;
      input && input.addEventListener('input', function(e) {
        clearTimeout(_t);
        _t = setTimeout(function() { renderResults(e.target.value); }, 200);
      });

      input && input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && input.value.trim()) {
          window.location.href = '/search?q=' + encodeURIComponent(input.value.trim());
        }
      });
    });
  </script>

</body>
</html>
