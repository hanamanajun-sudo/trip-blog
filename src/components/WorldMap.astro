<style>
  .pin-outer { transition: r 0.2s, opacity 0.2s; }
  .pin-dot   { transition: r 0.2s; }
  .map-pin-link:hover .pin-outer { r: 11; opacity: 0.35; }
  .map-pin-link:hover .pin-dot   { r: 5.5; fill: #1d4ed8; }
  .map-pin-link:focus .pin-dot   { fill: #1d4ed8; outline: none; }

  @keyframes pulse-ring {
    0%   { r: 4;  opacity: 0.6; }
    70%  { r: 10; opacity: 0; }
    100% { r: 10; opacity: 0; }
  }
  /* 첫 로드 시 펄스 (첫 5개 핀만) */
  .map-pin-link:nth-child(-n+5) .pin-outer {
    animation: pulse-ring 2s ease-out 1;
  }
</style>

<script is:inline>
(function() {
  var tooltip = document.getElementById('map-tooltip');
  var tName   = document.getElementById('tooltip-name');
  var tTitle  = document.getElementById('tooltip-title');
  var wrapper = document.querySelector('.world-map-wrapper');
  if (!tooltip || !wrapper) return;

  document.querySelectorAll('.map-pin-link').forEach(function(el) {
    el.addEventListener('mouseenter', function(e) {
      var rect = wrapper.getBoundingClientRect();
      var svgEl = wrapper.querySelector('svg');
      var svgRect = svgEl.getBoundingClientRect();

      // SVG viewBox(0~1000, 0~500) → 실제 화면 좌표 변환
      var dot = el.querySelector('.pin-dot');
      var cx = parseFloat(dot.getAttribute('cx'));
      var cy = parseFloat(dot.getAttribute('cy'));
      var scaleX = svgRect.width / 1000;
      var scaleY = svgRect.height / 500;
      var screenX = svgRect.left - rect.left + cx * scaleX;
      var screenY = svgRect.top  - rect.top  + cy * scaleY;

      tName.textContent  = el.dataset.name;
      tTitle.textContent = el.dataset.title;
      tooltip.style.left = screenX + 'px';
      tooltip.style.top  = screenY + 'px';
      tooltip.classList.remove('hidden');
    });
    el.addEventListener('mouseleave', function() {
      tooltip.classList.add('hidden');
    });
  });
})();
</script>
