<style>
  .pin-outer { transition: r 0.18s, opacity 0.18s; }
  .pin-dot   { transition: r 0.18s, fill 0.18s; }
  .map-pin-link { cursor: pointer; }
  @media (hover: hover) {
    .map-pin-link:hover .pin-outer { r: 12; opacity: 0.35; }
    .map-pin-link:hover .pin-dot   { r: 5; fill: #1d4ed8; }
  }
  .map-pin-link:focus { outline: none; }
  .map-pin-link:focus .pin-dot   { fill: #1d4ed8; }
  #map-tooltip:not(.hidden) { display: block; }
</style>

<script is:inline>
(function() {
  var tooltip = document.getElementById('map-tooltip');
  var tName   = document.getElementById('tooltip-name');
  var tTitle  = document.getElementById('tooltip-title');
  var outer   = document.querySelector('.world-map-outer');
  var wrapper = document.querySelector('.world-map-wrapper');
  if (!tooltip || !outer || !wrapper) return;

  // 터치 기기 여부 (hover 불가)
  var isTouch = window.matchMedia('(hover: none)').matches;
  // 데스크톱에선 툴팁이 마우스 가로채지 않도록
  tooltip.style.pointerEvents = isTouch ? 'auto' : 'none';

  function place(el) {
    var svgR = wrapper.querySelector('svg').getBoundingClientRect();
    var outR = outer.getBoundingClientRect();
    var dot  = el.querySelector('.pin-dot');
    var pinX = (svgR.left - outR.left) + parseFloat(dot.getAttribute('cx')) * (svgR.width  / 1000);
    var pinY = (svgR.top  - outR.top)  + parseFloat(dot.getAttribute('cy')) * (svgR.height / 500);

    tooltip.href = el.getAttribute('href');
    tName.textContent  = el.dataset.name;
    tTitle.textContent = el.dataset.title;
    tooltip.classList.remove('hidden');

    var ttW = tooltip.offsetWidth, ttH = tooltip.offsetHeight, gap = 10;
    var left = Math.max(4, Math.min(pinX - ttW / 2, outR.width - ttW - 4));
    var top  = pinY - ttH - gap;
    if (top < 0) top = pinY + gap + 8;
    tooltip.style.left = left + 'px';
    tooltip.style.top  = top  + 'px';
  }
  function hide() { tooltip.classList.add('hidden'); }

  document.querySelectorAll('.map-pin-link').forEach(function(el) {
    if (isTouch) {
      // 모바일: 첫 탭 → 미니카드 표시(이동 보류), 카드 누르면 이동
      el.addEventListener('click', function(e) {
        if (tooltip.classList.contains('hidden') || tooltip.href.indexOf(el.getAttribute('href')) === -1) {
          e.preventDefault();
          place(el);
        }
      });
    } else {
      // 데스크톱: hover로 미리보기, 클릭은 그대로 이동
      el.addEventListener('mouseenter', function() { place(el); });
      el.addEventListener('mouseleave', hide);
      el.addEventListener('focus', function() { place(el); });
      el.addEventListener('blur', hide);
    }
  });

  // 모바일: 바깥 탭하면 카드 닫기
  if (isTouch) {
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.map-pin-link') && !e.target.closest('#map-tooltip')) hide();
    });
  }
})();
</script>
