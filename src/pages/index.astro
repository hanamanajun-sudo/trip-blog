---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 카테고리 목록
const categories = [...new Set(posts.map(p => p.data.category))].sort();

// 본문에서 첫 번째 이미지 추출
function getFirstImage(body: string): string | null {
  const match = body.match(/!\[.*?\]\((\/images\/[^)]+)\)/);
  return match ? match[1] : null;
}

// 카테고리별 아이콘
const categoryIcons: Record<string, string> = {
  '해외 여행': 'ph-globe',
  '국내 여행': 'ph-map-pin',
  '나라 정보': 'ph-flag',
  '역사': 'ph-book-open',
  '여행': 'ph-airplane',
  '캠핑': 'ph-tent',
  '커피': 'ph-coffee',
  '지구 상식': 'ph-planet',
  '지구 위기& 재난 대비': 'ph-warning',
  '유튜버 되기 자료': 'ph-video-camera',
};

// 카테고리별 그라디언트 (이미지 없을 때)
const categoryGradients: Record<string, string> = {
  '해외 여행': 'from-sky-400 to-blue-600',
  '국내 여행': 'from-emerald-400 to-teal-600',
  '나라 정보': 'from-violet-400 to-purple-600',
  '역사': 'from-amber-400 to-orange-600',
  '여행': 'from-cyan-400 to-sky-600',
  '캠핑': 'from-green-400 to-emerald-600',
  '커피': 'from-yellow-600 to-amber-800',
  '지구 상식': 'from-blue-400 to-indigo-600',
  '지구 위기& 재난 대비': 'from-red-400 to-rose-600',
  '유튜버 되기 자료': 'from-pink-400 to-fuchsia-600',
};
---

<BaseLayout title="lalalakorea - 세계 여행, 나라 정보, 역사 이야기">

  <!-- 히어로 섹션 -->
  <section class="relative rounded-2xl overflow-hidden mb-10 bg-gradient-to-br from-primary to-sky-700 text-white px-8 py-12 shadow-lg">
    <!-- 배경 패턴 -->
    <div class="absolute inset-0 opacity-10" style="background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");"></div>
    <div class="relative">
      <div class="flex items-center gap-3 mb-3">
        <i class="ph ph-airplane-takeoff text-4xl text-white/90"></i>
        <h1 class="text-4xl font-bold tracking-tight">lalalakorea</h1>
      </div>
      <p class="text-lg text-white/80 mb-6">세계 여행 · 나라 정보 · 역사 이야기</p>
      <div class="flex items-center gap-2 text-sm text-white/70">
        <i class="ph ph-article text-base"></i>
        <span>총 {posts.length}개의 글</span>
        <span class="mx-2">·</span>
        <i class="ph ph-tag text-base"></i>
        <span>{categories.length}개 카테고리</span>
      </div>
    </div>
  </section>

  <!-- 카테고리 필터 -->
  <div class="flex flex-wrap gap-2 mb-8">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-full bg-primary text-white px-4 py-1.5 text-sm font-medium shadow-sm transition-all hover:bg-primary/90 hover:shadow-md"
    >
      <i class="ph ph-squares-four text-sm"></i>
      전체
    </a>
    {categories.map(cat => (
      <a
        href={`/category/${cat}`}
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-1.5 text-sm font-medium text-foreground/70 hover:bg-primary/10 hover:text-primary hover:border-primary/30 transition-all"
      >
        <i class={`ph ${categoryIcons[cat] || 'ph-tag'} text-sm`}></i>
        {cat}
      </a>
    ))}
  </div>

  <!-- 글 목록 - 카드 그리드 -->
  <section>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {sortedPosts.map((post, index) => {
        const formattedDate = new Intl.DateTimeFormat('ko-KR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }).format(new Date(post.data.date));

        const isFeatured = index === 0;
        const thumbnail = post.data.thumbnail || getFirstImage(post.body ?? '');

        return isFeatured ? (
          /* Featured 카드: 이미지 왼쪽 + 텍스트 오른쪽 수평 레이아웃 */
          <a
            href={`/entry/${post.data.entry_slug || post.id}`}
            class="group md:col-span-2 flex flex-col sm:flex-row rounded-xl border border-border bg-card overflow-hidden shadow-sm transition-all hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/40"
          >
            {/* 이미지 - 왼쪽 고정 크기 */}
            {thumbnail ? (
              <div class="overflow-hidden bg-muted sm:w-64 sm:shrink-0 h-48 sm:h-auto">
                <img
                  src={thumbnail}
                  alt={post.data.title}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class={`flex flex-col items-center justify-center gap-2 bg-gradient-to-br ${categoryGradients[post.data.category] || 'from-sky-400 to-blue-600'} sm:w-64 sm:shrink-0 h-36 sm:h-auto`}>
                <i class={`ph ${categoryIcons[post.data.category] || 'ph-image'} text-4xl text-white/80`}></i>
                <span class="text-xs text-white/70 font-medium">{post.data.category}</span>
              </div>
            )}
            {/* 텍스트 - 오른쪽 */}
            <div class="flex flex-col gap-3 p-6 flex-1 justify-center">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
                  <i class={`ph ${categoryIcons[post.data.category] || 'ph-tag'} text-xs`}></i>
                  {post.data.category}
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 text-accent px-2.5 py-0.5 text-xs font-semibold">
                  <i class="ph ph-star text-xs"></i>
                  최신글
                </span>
              </div>
              <h2 class="text-xl font-bold leading-snug tracking-tight group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground line-clamp-3">{post.data.description}</p>
              )}
              <div class="flex items-center justify-between">
                <time class="flex items-center gap-1 text-xs text-muted-foreground">
                  <i class="ph ph-calendar text-xs"></i>
                  {formattedDate}
                </time>
                <span class="flex items-center gap-1 text-xs text-primary font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                  읽기 <i class="ph ph-arrow-right"></i>
                </span>
              </div>
            </div>
          </a>
        ) : (
          /* 일반 카드: 세로 레이아웃 */
          <a
            href={`/entry/${post.data.entry_slug || post.id}`}
            class="group flex flex-col rounded-xl border border-border bg-card overflow-hidden shadow-sm transition-all hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/40"
          >
            {thumbnail ? (
              <div class="overflow-hidden bg-muted h-36">
                <img
                  src={thumbnail}
                  alt={post.data.title}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class={`flex flex-col items-center justify-center gap-2 bg-gradient-to-br ${categoryGradients[post.data.category] || 'from-sky-400 to-blue-600'} h-28`}>
                <i class={`ph ${categoryIcons[post.data.category] || 'ph-image'} text-4xl text-white/80`}></i>
                <span class="text-xs text-white/70 font-medium">{post.data.category}</span>
              </div>
            )}

            {/* 콘텐츠 */}
            <div class="flex flex-col gap-2 p-5 flex-1">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
                  <i class={`ph ${categoryIcons[post.data.category] || 'ph-tag'} text-xs`}></i>
                  {post.data.category}
                </span>
              </div>
              <h2 class="text-base font-bold leading-snug tracking-tight group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground line-clamp-2 flex-1">{post.data.description}</p>
              )}
              <div class="flex items-center justify-between mt-2">
                <time class="flex items-center gap-1 text-xs text-muted-foreground">
                  <i class="ph ph-calendar text-xs"></i>
                  {formattedDate}
                </time>
                <i class="ph ph-arrow-right text-sm text-primary opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
              </div>
            </div>
          </a>
        );
      })}

    </div>
  </section>

</BaseLayout>
