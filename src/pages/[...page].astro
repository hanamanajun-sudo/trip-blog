---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { slugify } from '../utils/slugify';
import WorldMap from '../components/WorldMap.astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = await getCollection('blog', ({ data }: any) => !data.draft);
  const sortedPosts = allPosts.sort((a: any, b: any) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
  return paginate(sortedPosts, { pageSize: 20 });
}

const { page } = Astro.props as any;

// 카테고리 목록 (전체 posts에서 추출)
const allPosts = await getCollection('blog', ({ data }: any) => !data.draft);
const categories = [...new Set(allPosts.map((p: any) => p.data.category))].sort() as string[];

// 본문에서 첫 번째 이미지 추출
function getFirstImage(body: string): string | null {
  // 이미지 마크다운: ![alt](/images/path.jpg) 또는 ![alt](/images/path.jpg "타이틀")
  const match = body.match(/!\[.*?\]\((\/images\/[^\s")]+)/);
  return match ? match[1] : null;
}

// 카테고리별 아이콘
const categoryIcons: Record<string, string> = {
  '해외 여행': 'ph-globe',
  '국내 여행': 'ph-map-pin',
  '나라 정보': 'ph-flag',
  '역사': 'ph-book-open',
  '여행': 'ph-airplane',
  '캠핑': 'ph-tent',
  '커피': 'ph-coffee',
  '지구 상식': 'ph-planet',
  '지구 위기& 재난 대비': 'ph-warning',
  '유튜버 되기 자료': 'ph-video-camera',
};

const categoryGradients: Record<string, string> = {
  '해외 여행': 'from-sky-400 to-blue-600',
  '국내 여행': 'from-emerald-400 to-teal-600',
  '나라 정보': 'from-violet-400 to-purple-600',
  '역사': 'from-amber-400 to-orange-600',
  '여행': 'from-cyan-400 to-sky-600',
  '캠핑': 'from-green-400 to-emerald-600',
  '커피': 'from-yellow-600 to-amber-800',
  '지구 상식': 'from-blue-400 to-indigo-600',
  '지구 위기& 재난 대비': 'from-red-400 to-rose-600',
  '유튜버 되기 자료': 'from-pink-400 to-fuchsia-600',
};

const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
  ? 'trip.lalalakorea - 세계 여행, 나라 정보, 역사 이야기'
  : `trip.lalalakorea - ${page.currentPage}페이지`;
const pageDescription = isFirstPage
  ? '우리나라와 비교해서 알아보는 세계 여행·나라 정보·역사 이야기 블로그입니다. 나라별 크기·인구·시차를 한눈에 확인하세요.'
  : `trip.lalalakorea 블로그 ${page.currentPage}페이지 — 세계 여행, 나라 정보, 역사 이야기 글 목록입니다.`;

---

<BaseLayout title={pageTitle} description={pageDescription}>
  {page.url.prev && <link slot="head" rel="prev" href={`https://trip.lalalakorea.com${page.url.prev}`} />}
  {page.url.next && <link slot="head" rel="next" href={`https://trip.lalalakorea.com${page.url.next}`} />}

  <!-- 히어로 섹션 (1페이지만) -->
  {isFirstPage && (
    <section class="relative rounded-2xl overflow-hidden mb-10 bg-gradient-to-br from-primary to-sky-700 text-white px-8 py-12 shadow-lg">
      <div class="absolute inset-0 opacity-10" style="background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");"></div>
      <div class="relative">
        <div class="flex items-center gap-3 mb-3">
          <i class="ph ph-airplane-takeoff text-4xl text-white/90" aria-hidden="true"></i>
          <h1 class="text-4xl font-bold tracking-tight">trip.lalalakorea</h1>
        </div>
        <p class="text-lg text-white/80 mb-6">세계 여행 · 나라 정보 · 역사 이야기</p>
        <div class="flex items-center gap-2 text-sm text-white/70">
          <i class="ph ph-article text-base" aria-hidden="true"></i>
          <span>총 {page.total}개의 글</span>
          <span class="mx-2">·</span>
          <i class="ph ph-tag text-base" aria-hidden="true"></i>
          <span>{categories.length}개 카테고리</span>
        </div>
      </div>
    </section>
  )}

  <!-- 2페이지 이상: 간단한 헤더 -->
  {!isFirstPage && (
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-2xl font-bold">전체 글 — {page.currentPage}페이지</h1>
      <span class="text-sm text-muted-foreground">{page.total}개 글 · {page.lastPage}페이지</span>
    </div>
  )}

  <!-- 지구 상식 시리즈 세계지도 (1페이지만) -->
  {isFirstPage && (
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-100 text-blue-600">
            <i class="ph ph-planet text-lg" aria-hidden="true"></i>
          </span>
          <div>
            <h2 class="text-lg font-bold tracking-tight leading-none">지구 상식 시리즈</h2>
            <p class="text-xs text-muted-foreground mt-0.5">지도에서 대륙을 누르면 그 지역 나라들이 펼쳐져요</p>
          </div>
        </div>
      </div>
      <WorldMap />
    </section>
  )}

  <!-- 카테고리 필터 -->
  <div class="flex flex-wrap gap-2 mb-8">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-full bg-primary text-white px-4 py-1.5 text-sm font-medium shadow-sm transition-all hover:bg-primary/90 hover:shadow-md"
    >
      <i class="ph ph-squares-four text-sm" aria-hidden="true"></i>
      전체
    </a>
    {categories.map((cat: string) => (
      <a
        href={`/category/${slugify(cat)}`}
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-4 py-1.5 text-sm font-medium text-foreground/70 hover:bg-primary/10 hover:text-primary hover:border-primary/30 transition-all"
      >
        <i class={`ph ${categoryIcons[cat] || 'ph-tag'} text-sm`}></i>
        {cat}
      </a>
    ))}
  </div>

  <!-- 글 목록 -->
  <section>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {page.data.map((post: any, index: number) => {
        const formattedDate = new Intl.DateTimeFormat('ko-KR', {
          year: 'numeric', month: 'long', day: 'numeric',
        }).format(new Date(post.data.date));

        const isFeatured = isFirstPage && index === 0;
        const thumbnail = post.data.thumbnail || getFirstImage(post.body ?? '');

        return isFeatured ? (
          <a
            href={`/entry/${post.data.entry_slug || post.id}`}
            class="group md:col-span-2 flex flex-col sm:flex-row rounded-xl border border-border bg-card overflow-hidden shadow-sm transition-all hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/40"
          >
            {thumbnail ? (
              <div class="overflow-hidden bg-muted sm:w-64 sm:shrink-0 h-48 sm:h-auto">
                <img src={thumbnail} alt={post.data.title} class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            ) : (
              <div class={`flex flex-col items-center justify-center gap-2 bg-gradient-to-br ${categoryGradients[post.data.category] || 'from-sky-400 to-blue-600'} sm:w-64 sm:shrink-0 h-36 sm:h-auto`}>
                <i class={`ph ${categoryIcons[post.data.category] || 'ph-image'} text-4xl text-white/80`}></i>
                <span class="text-xs text-white/70 font-medium">{post.data.category}</span>
              </div>
            )}
            <div class="flex flex-col gap-3 p-6 flex-1 justify-center">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
                  <i class={`ph ${categoryIcons[post.data.category] || 'ph-tag'} text-xs`}></i>
                  {post.data.category}
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 text-accent px-2.5 py-0.5 text-xs font-semibold">
                  <i class="ph ph-star text-xs" aria-hidden="true"></i>
                  최신글
                </span>
              </div>
              <h2 class="text-xl font-bold leading-snug tracking-tight group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground line-clamp-3">{post.data.description}</p>
              )}
              <div class="flex items-center justify-between">
                <time class="flex items-center gap-1 text-xs text-muted-foreground">
                  <i class="ph ph-calendar text-xs" aria-hidden="true"></i>
                  {formattedDate}
                </time>
                <span class="flex items-center gap-1 text-xs text-primary font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                  읽기 <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </span>
              </div>
            </div>
          </a>
        ) : (
          <a
            href={`/entry/${post.data.entry_slug || post.id}`}
            class="group flex flex-col rounded-xl border border-border bg-card overflow-hidden shadow-sm transition-all hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/40"
          >
            {thumbnail ? (
              <div class="overflow-hidden bg-muted h-36">
                <img src={thumbnail} alt={post.data.title} class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            ) : (
              <div class={`flex flex-col items-center justify-center gap-2 bg-gradient-to-br ${categoryGradients[post.data.category] || 'from-sky-400 to-blue-600'} h-28`}>
                <i class={`ph ${categoryIcons[post.data.category] || 'ph-image'} text-4xl text-white/80`}></i>
                <span class="text-xs text-white/70 font-medium">{post.data.category}</span>
              </div>
            )}
            <div class="flex flex-col gap-2 p-5 flex-1">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
                  <i class={`ph ${categoryIcons[post.data.category] || 'ph-tag'} text-xs`}></i>
                  {post.data.category}
                </span>
              </div>
              <h2 class="text-base font-bold leading-snug tracking-tight group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground line-clamp-2 flex-1">{post.data.description}</p>
              )}
              <div class="flex items-center justify-between mt-2">
                <time class="flex items-center gap-1 text-xs text-muted-foreground">
                  <i class="ph ph-calendar text-xs" aria-hidden="true"></i>
                  {formattedDate}
                </time>
                <i class="ph ph-arrow-right text-sm text-primary opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" aria-hidden="true"></i>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 페이지네이션 -->
  {page.lastPage > 1 && (
    <nav class="flex items-center justify-center gap-2 mt-12 pt-8 border-t border-border">
      <!-- 이전 -->
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-4 py-2 text-sm font-medium text-foreground hover:bg-primary/10 hover:text-primary hover:border-primary/30 transition-all"
        >
          <i class="ph ph-arrow-left" aria-hidden="true"></i>
          이전
        </a>
      ) : (
        <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-muted px-4 py-2 text-sm font-medium text-muted-foreground cursor-not-allowed opacity-50">
          <i class="ph ph-arrow-left" aria-hidden="true"></i>
          이전
        </span>
      )}

      <!-- 페이지 번호 -->
      <div class="flex items-center gap-1">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum: number) => {
          const isCurrentPage = pageNum === page.currentPage;
          const isFar = Math.abs(pageNum - page.currentPage) > 2 && pageNum !== 1 && pageNum !== page.lastPage;
          if (isFar) return null;

          const href = pageNum === 1 ? '/' : `/${pageNum}`;
          return isCurrentPage ? (
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary text-white text-sm font-bold shadow-sm">
              {pageNum}
            </span>
          ) : (
            <a
              href={href}
              class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-border bg-white text-sm font-medium text-foreground hover:bg-primary/10 hover:text-primary hover:border-primary/30 transition-all"
            >
              {pageNum}
            </a>
          );
        })}
      </div>

      <!-- 다음 -->
      {page.url.next ? (
        <a
          href={page.url.next}
          class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-4 py-2 text-sm font-medium text-foreground hover:bg-primary/10 hover:text-primary hover:border-primary/30 transition-all"
        >
          다음
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      ) : (
        <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-muted px-4 py-2 text-sm font-medium text-muted-foreground cursor-not-allowed opacity-50">
          다음
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </span>
      )}
    </nav>
  )}

</BaseLayout>
