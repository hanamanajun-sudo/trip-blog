---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postCount = allPosts.length;
---

<BaseLayout title="검색 - lalalakorea" description="lalalakorea 블로그에서 여행, 나라 정보, 역사 글을 검색해보세요">
  <div class="max-w-3xl mx-auto py-8">

    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-primary mb-2">
        <i class="ph ph-magnifying-glass mr-2 text-accent" aria-hidden="true"></i>블로그 검색
      </h1>
      <p class="text-muted-foreground text-sm">{postCount}개 글에서 원하는 여행지·나라 정보를 찾아보세요</p>
    </div>

    <!-- 검색 입력창 -->
    <div class="relative mb-6">
      <i class="ph ph-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground text-lg" aria-hidden="true"></i>
      <input
        id="search-page-input"
        type="text"
        placeholder="여행지, 나라 이름, 키워드를 검색하세요..."
        class="w-full pl-11 pr-4 py-3 border border-border rounded-xl text-base outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white"
        autocomplete="off"
      />
    </div>

    <!-- 결과 수 표시 -->
    <p id="result-count" class="text-sm text-muted-foreground mb-4 hidden"></p>

    <!-- 검색 결과 -->
    <div id="search-page-results">
      <div class="py-16 text-center text-muted-foreground">
        <i class="ph ph-compass text-5xl mb-4 block text-accent/40" aria-hidden="true"></i>
        <p class="text-base font-medium mb-1">검색어를 입력해보세요</p>
        <p class="text-sm">나라 이름, 여행지, 궁금한 주제 뭐든지 OK</p>
      </div>
    </div>

  </div>
</BaseLayout>

<!-- Fuse.js CDN (빌드 과정에 영향 없음) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/7.0.0/fuse.min.js" is:inline></script>

<script is:inline>
  var fuse = null;
  var searchData = [];

  // 검색 인덱스 로드
  fetch('/search-index.json')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      searchData = data;
      fuse = new Fuse(data, {
        keys: [
          { name: 'title', weight: 0.6 },
          { name: 'description', weight: 0.3 },
          { name: 'category', weight: 0.1 },
        ],
        threshold: 0.4,
        includeScore: true,
        minMatchCharLength: 2,
      });

      // URL ?q= 파라미터로 초기 검색
      var params = new URLSearchParams(window.location.search);
      var q = params.get('q');
      if (q) {
        var input = document.getElementById('search-page-input');
        if (input) {
          input.value = q;
          doSearch(q);
        }
      }
    })
    .catch(function(e) { console.warn('검색 인덱스 로드 실패:', e); });

  function doSearch(query) {
    var results = document.getElementById('search-page-results');
    var count = document.getElementById('result-count');
    if (!results) return;

    if (!query.trim()) {
      count.classList.add('hidden');
      results.innerHTML = '<div class="py-16 text-center text-muted-foreground"><i class="ph ph-compass text-5xl mb-4 block text-accent/40" aria-hidden="true"></i><p class="text-base font-medium mb-1">검색어를 입력해보세요</p><p class="text-sm">나라 이름, 여행지, 궁금한 주제 뭐든지 OK</p></div>';
      return;
    }

    if (!fuse) {
      results.innerHTML = '<div class="py-8 text-center text-sm text-muted-foreground">검색 준비 중...</div>';
      return;
    }

    var found = fuse.search(query);

    if (found.length === 0) {
      count.classList.add('hidden');
      results.innerHTML = '<div class="py-16 text-center text-muted-foreground"><i class="ph ph-smiley-sad text-5xl mb-4 block" aria-hidden="true"></i><p class="text-base font-medium mb-1">"' + query + '" 검색 결과가 없어요</p><p class="text-sm">다른 키워드로 검색해보세요</p></div>';
      return;
    }

    count.textContent = '"' + query + '" 검색 결과 ' + found.length + '개';
    count.classList.remove('hidden');

    results.innerHTML = found.map(function(r) {
      var item = r.item;
      var categoryColors = {
        '해외 여행': 'bg-sky-50 text-sky-700',
        '국내 여행': 'bg-emerald-50 text-emerald-700',
        '나라 정보': 'bg-violet-50 text-violet-700',
        '지구 상식': 'bg-blue-50 text-blue-700',
        '역사': 'bg-amber-50 text-amber-700',
      };
      var badgeClass = categoryColors[item.category] || 'bg-gray-50 text-gray-600';

      return '<a href="' + item.url + '" class="flex flex-col gap-2 p-4 rounded-xl border border-border hover:border-primary/40 hover:bg-primary/5 transition-all mb-3 group">' +
        '<div class="flex items-start justify-between gap-3">' +
          '<div class="font-semibold text-foreground group-hover:text-primary transition-colors line-clamp-2 flex-1">' + item.title + '</div>' +
          (item.category ? '<span class="text-xs px-2 py-0.5 rounded-full whitespace-nowrap flex-shrink-0 ' + badgeClass + '">' + item.category + '</span>' : '') +
        '</div>' +
        (item.description ? '<div class="text-sm text-muted-foreground line-clamp-2">' + item.description + '</div>' : '') +
      '</a>';
    }).join('');
  }

  // 입력 이벤트 (디바운스)
  var timer;
  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('search-page-input');
    if (input) {
      input.addEventListener('input', function(e) {
        clearTimeout(timer);
        timer = setTimeout(function() { doSearch(e.target.value); }, 200);
      });
      input.focus();
    }
  });
</script>
