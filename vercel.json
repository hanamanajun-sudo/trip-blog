{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/images/placeholder-germany-hero.jpg",
      "destination": "/images/germany-hero.jpg",
      "permanent": true
    },
    {
      "source": "/images/placeholder-brazil-hero.jpg",
      "destination": "/images/brazil-hero.jpg",
      "permanent": true
    },
    {
      "source": "/images/placeholder-가나-hero.jpg",
      "destination": "/images/ghana-hero.jpg",
      "permanent": true
    },
    {
      "source": "/category/유튜버 되기 자료",
      "destination": "/category/유튜버-되기-자료",
      "permanent": true
    },
    {
      "source": "/tag/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/m/entry/:slug",
      "destination": "/entry/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
